# -----------------------------------------------------------------------------
# Frontend Environment Configuration Template
# Copy this file to .env.local and fill in your values.
# NEVER commit your actual .env or .env.local file to version control.
# -----------------------------------------------------------------------------

# LiveKit Cloud Configuration (Used server-side by /api/livekit-token)
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Backend API Base URL (Used by client-side API requests)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
