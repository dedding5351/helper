# -----------------------------------------------------------------------------
# Backend Environment Configuration Template
# Copy this file to .env.local (or .env) and fill in your values.
# NEVER commit your actual .env or .env.local file to version control.
# -----------------------------------------------------------------------------

# Google GenAI / Gemini API Key (Required for embeddings and voice agent)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative environment variable name accepted by google-genai
GOOGLE_API_KEY=your_gemini_api_key_here

# LiveKit Cloud Configuration (Required for voice agent worker)
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Voice Agent Worker Settings
AGENT_NAME=Test-Helper
AGENT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
AGENT_VOICE=Puck
AGENT_TEMPERATURE=0.8

# Backend API Configuration
BACKEND_API_URL=http://localhost:8000/api/v1

# CORS: Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
